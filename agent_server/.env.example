# ── Agent server ────────────────────────────────────────────────────────────
AGENT_HOST=0.0.0.0
AGENT_PORT=8002

# Agent DB — operational store ONLY (jobs, checkpoints, seen-cache, outbox,
# audit). SEPARATE Postgres database from the platform's apply_tools DB.
AGENT_DATABASE_URL=postgresql://apply:apply@localhost:5432/apply_agent

# Platform API — source of truth for verified leads. The agent server is a CLIENT.
PLATFORM_API_BASE=http://localhost:8001
# PLATFORM_API_TOKEN=shared-secret   # optional; sent as X-Agent-Token

# ── Run shape ───────────────────────────────────────────────────────────────
HUNT_TARGET_COUNT=50
LOOP_SLEEP_MIN_S=0.5
LOOP_SLEEP_MAX_S=2.0

# ── Runtime LLM agents (discovery + research) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
AGENT_LLM_MODEL=claude-opus-4-8

# ── Structured-floor discovery sources ──────────────────────────────────────
YC_OSS_URL=https://yc-oss.github.io/api/companies/all.json
# PRODUCT_HUNT_TOKEN=xxxx   # Product Hunt developer token (free)

# ── Verification waterfall (free-tier APIs in order, then SMTP fallback) ─────
VERIFY_PROVIDERS=hunter,abstract
# HUNTER_API_KEY=xxxx
# ABSTRACT_API_KEY=xxxx
SMTP_FALLBACK_ENABLED=true

# ── Logging (shared with platform conventions) ──────────────────────────────
LOG_FORMAT=console     # or "json"
LOG_LEVEL=INFO
ENV=development

# ── Google Gemini (optional LLM provider) ───────────────────────────────────
# Set AGENT_LLM_PROVIDER=gemini to run the agents on Gemini instead of Claude.
#
# GEMINI_API_KEY is a Google AI STUDIO key — https://aistudio.google.com/apikey
# (Create API key; starts with AIza...). Vertex AI is a different product using
# ADC / service accounts and is not what this speaks to.
# AGENT_LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.5-flash

# ── Google Vertex AI (Gemini billed to a GCP project) ───────────────────────
# Use instead of GEMINI_API_KEY when an org policy disallows API keys, or to
# spend Google Cloud credits. Authenticates with Application Default
# Credentials — no key file:
#   gcloud auth application-default login
#   gcloud config set project <PROJECT_ID>
#   gcloud services enable aiplatform.googleapis.com
# AGENT_LLM_PROVIDER=vertex
# VERTEX_PROJECT=my-gcp-project-id
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=google/gemini-2.5-flash

# Match roles by whether we have SEEN them before, not by whether they were
# posted today. The code default is true, which means an evening scan matches
# nothing; dedup already guarantees no repeats, so false is what you want.
JOBBOARD_TODAY_ONLY=false

# ── Job Board schedule: when to scrape, and when to alert ─────────────────
# All times below are interpreted in JOBBOARD_TIMEZONE (an IANA zone name), so
# they keep meaning the same wall-clock hour across a DST shift.
JOBBOARD_TIMEZONE=America/New_York

# SCRAPE — re-check boards every N hours, but only inside the active window and
# on the listed days. Career pages publish during business hours, so scanning at
# 04:00 spends requests to learn nothing. Set start == end for 24/7.
# Days: "*", "mon-fri", or a list like "mon,wed,fri".
JOBBOARD_MONITOR_INTERVAL_H=3
JOBBOARD_MONITOR_ACTIVE_START=07:00
JOBBOARD_MONITOR_ACTIVE_END=23:00
JOBBOARD_MONITOR_DAYS=mon-fri

# ALERT — explicit times of day, comma-separated. This WINS over
# JOBBOARD_ALERT_INTERVAL_H, which is only the fallback when JOBBOARD_ALERT_AT
# is left blank. Narrowing these never loses roles: the alert window is a
# watermark, so anything found outside alert hours rolls into the next alert.
JOBBOARD_ALERT_AT=09:00,18:00
JOBBOARD_ALERT_DAYS=*
# JOBBOARD_ALERT_INTERVAL_H=6
