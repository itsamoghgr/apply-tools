# Copy this file to .env and fill in your real keys.

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. Must match the frontend's frontend/.env so the
# FastAPI backend (SQLAlchemy) and Next.js (Prisma) hit the same database.
# Local default created by the dev setup (see dev.md):
DATABASE_URL=postgresql://apply:apply@localhost:5432/apply_tools

# ── Provider selection ──────────────────────────────────────────────────────
# AI_PROVIDER controls which backend is used for ALL generation calls
# (cover letters, scoring, JD extraction).
# Options: "anthropic" (default), "groq", "nvidia", "bedrock", "gemini", "vertex"
# AI_PROVIDER=nvidia

# SCORE_PROVIDER overrides just the scoring path (defaults to AI_PROVIDER).
# SCORE_PROVIDER=groq

# EXTRACT_PROVIDER overrides just the JD auto-detect path. Defaults to Groq
# (fast Llama), then falls back Bedrock -> Anthropic -> NVIDIA.
# EXTRACT_PROVIDER=groq

# ── Recommended setup: Bedrock Claude Sonnet for generation, Groq for extract ─
# AI_PROVIDER=bedrock          # cover / email / question / score -> Claude Sonnet 4.5
# EXTRACT_PROVIDER=groq        # auto-detect -> fast Groq Llama, falls back Bedrock -> Anthropic (needs GROQ_API_KEY)

# On a recoverable failure (rate-limit / quota / timeout) the primary provider
# falls back down its chain until one succeeds. Generation order:
# bedrock -> groq -> anthropic -> nvidia. JD auto-detect order:
# groq -> bedrock -> anthropic -> nvidia. NVIDIA NIM is LAST in both because its
# public endpoint frequently times out (>45s). Configure the keys for whichever
# providers you want in the chain; an unconfigured provider is simply skipped.
# Anthropic is the reliable backstop, so keeping ANTHROPIC_API_KEY set is
# recommended even off-default.

# Per-call timeout ceilings (seconds). LLM_TIMEOUT_SECS caps any single
# generation/score call; EXTRACT_TIMEOUT_SECS is a tighter per-hop cap for JD
# auto-detect so a slow/hung hop fails fast and the fallback chain advances
# within the extension's client timeout.
# LLM_TIMEOUT_SECS=45
# EXTRACT_TIMEOUT_SECS=15

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
# Required when AI_PROVIDER=anthropic (the default).
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the default Claude model
# MODEL=claude-opus-4-5

# ── Groq ────────────────────────────────────────────────────────────────────
# Required when AI_PROVIDER=groq, or when SCORE_PROVIDER=groq.
# Get one at: https://console.groq.com (free tier is fine)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the default Groq model for generation tasks
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: override the Groq model used specifically for scoring
# SCORE_GROQ_MODEL=openai/gpt-oss-120b

# ── Google Vertex AI (Gemini billed to a GCP project) ───────────────────────
# Use this instead of GEMINI_API_KEY when your org policy disallows API keys,
# or when you want usage to draw on Google Cloud credits.
#
# Setup (no key file — ADC uses your gcloud identity):
#   brew install --cask google-cloud-sdk
#   gcloud auth application-default login
#   gcloud config set project <PROJECT_ID>
#   gcloud services enable aiplatform.googleapis.com
#
# AI_PROVIDER=vertex
# VERTEX_PROJECT=my-gcp-project-id
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=google/gemini-2.5-flash

# ── Google Gemini (AI Studio API key) ───────────────────────────────────────
# Required when AI_PROVIDER=gemini (and used as a fallback hop when set).
#
# This is a Google AI STUDIO key, not Vertex AI:
#   https://aistudio.google.com/apikey  ->  Create API key  (starts with AIza...)
# Vertex AI is a separate product that authenticates with ADC / service accounts
# and is NOT what this path speaks to.
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the default Gemini model.
# GEMINI_MODEL=gemini-2.5-flash

# ── NVIDIA NIM ──────────────────────────────────────────────────────────────
# Required when AI_PROVIDER=nvidia.
# Get one at: https://build.nvidia.com (free tier available)
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the default NIM model
# NIM_MODEL=meta/llama-3.3-70b-instruct

# ── AWS Bedrock ─────────────────────────────────────────────────────────────
# Used when AI_PROVIDER=bedrock, or as a fallback in the chain above.
# Auth uses the standard AWS credential chain: set AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY here, or rely on ~/.aws/credentials or an IAM role.
# The IAM principal needs bedrock:InvokeModel on the models below, and the
# models must be enabled in your account's Bedrock console for the region.
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Region for Bedrock. Falls back to AWS_REGION, then us-east-1.
# BEDROCK_REGION=us-east-1

# Generation / score / answer use Claude Sonnet 4.5 on Bedrock by default.
# Sonnet 4.5 requires a region-prefixed inference profile (us.* / global.*);
# the bare anthropic.claude-sonnet-4-5-... id raises a ValidationException.
# BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Auto-detect (JD extraction) uses Llama 3.3 70B on Bedrock by default,
# matching the lighter model used on the groq/nvidia extract path.
# Needs the region-prefixed inference profile; the bare id fails with
# "on-demand throughput isn't supported".
# BEDROCK_EXTRACT_MODEL=us.meta.llama3-3-70b-instruct-v1:0

# The extension's Chat tab is a free-form assistant that runs directly on
# Bedrock (Converse, plain text — no provider fallback chain). Defaults to the
# same Sonnet 4.5 profile as BEDROCK_MODEL; override to use a different model.
# BEDROCK_CHAT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# -----------------------------------------------------------------------------
# Logging (structlog). All optional — sensible defaults are applied.
# -----------------------------------------------------------------------------
# LOG_FORMAT: "console" for human-readable colored output (dev), "json" for
# structured one-line-per-event logs (prod). If unset, defaults to "json" when
# ENV=production, otherwise "console".
# LOG_FORMAT=console
#
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR. Defaults to INFO.
# LOG_LEVEL=INFO
#
# ENV: development | production. Drives the LOG_FORMAT default.
# ENV=development
